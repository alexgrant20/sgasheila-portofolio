# EmailJS credentials — all server-side only (no NEXT_PUBLIC_ prefix), so they
# never reach the browser. Copy this file to .env.local and fill in real values.
#
# Where to find each value in the EmailJS dashboard (https://dashboard.emailjs.com):
#   SERVICE_ID   Email Services  → your service → Service ID
#   TEMPLATE_ID  Email Templates → your template → Template ID
#   PUBLIC_KEY   Account → General → Public Key
#   PRIVATE_KEY  Account → General → Private Key
#
# The template must define these three variables:
#   {{from_name}}  {{from_email}}  {{message}}
#
# IMPORTANT: under Account → Security, switch on
# "Allow EmailJS API for non-browser applications".
# The server calls the REST API directly; without this every send returns 403.

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
