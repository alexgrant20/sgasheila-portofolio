# Web3Forms + reCAPTCHA — the site is a static export, so the contact form posts
# to Web3Forms directly from the browser. Both values must carry the
# NEXT_PUBLIC_ prefix to reach the client; neither is a secret (the reCAPTCHA
# *secret* key lives in the Web3Forms dashboard, never here). Copy this file to
# .env.local and fill in real values.
#
#   ACCESS_KEY      https://web3forms.com → create a form for the recipient email
#   RECAPTCHA_SITE_KEY  https://www.google.com/recaptcha/admin → reCAPTCHA v2
#                       "I'm not a robot" checkbox. Add the site's domain(s) and
#                       localhost. Paste the matching *secret* key into the
#                       Web3Forms form settings. Leave empty to disable the widget.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
