# EmailJS credentials — the site is a static export, so the contact form calls
# EmailJS's browser SDK directly. These must carry the NEXT_PUBLIC_ prefix to
# reach the client; there is no private key, since nothing here is a secret
# a browser can be trusted to hold. Copy this file to .env.local and fill in
# real values.
#
# Where to find each value in the EmailJS dashboard (https://dashboard.emailjs.com):
#   SERVICE_ID   Email Services  → your service → Service ID
#   TEMPLATE_ID  Email Templates → your template → Template ID
#   PUBLIC_KEY   Account → General → Public Key
#
# The template must define these three variables:
#   {{from_name}}  {{from_email}}  {{message}}

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
